APP_NAME=Launchpad
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty = host-only cookie (right for local development). Production on a split domain
# (app.example.com + api.example.com) needs the shared parent, e.g. SESSION_DOMAIN=.example.com
SESSION_DOMAIN=

# Live updates (Laravel Reverb). Generate real values per environment, e.g. `openssl rand -hex 32` for the key and secret.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the app PUBLISHES events (server to server). Inside Sail the Reverb process is the `reverb` compose service,
# so the app container reaches it at `reverb`; outside Sail use localhost. Browsers use their own host and port.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# What the Reverb process listens on inside its container (the compose service publishes REVERB_PORT to it).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Web app origins allowed to open a socket (comma list of origins or hosts; matched by HOST only; `*` is ignored).
REVERB_ALLOWED_ORIGINS=http://localhost:5173
FILESYSTEM_DISK=local
# Production must use a real async driver (database/redis), never sync: forgot-password defers its
# account-dependent work to the queue, and under sync it would become a timing oracle. Run a worker.
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_VIEWS_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=20
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Launchpad
WEB_URL=http://localhost:5173
HASH_DRIVER=argon2id
# Production: SESSION_SECURE_COOKIE=true (the device cookie also falls back to the request scheme when this is unset)
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Production: the IPs/CIDRs of your load balancer, comma-separated. Empty trusts no proxy; `*` is ignored on purpose.
# Without it every request looks like it comes from the proxy and all IP-keyed limits and ip_hash values collapse.
TRUSTED_PROXIES=
# Required (min 32 chars). openssl rand -hex 32, different per environment. Rotating it invalidates every stored ip/device hash.
LAUNCHPAD_HMAC_KEY=
AVATAR_DISK=public
PRODUCT_DISK=public
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/api/v1/auth/google/callback
# Production: comma-separated OAuth client ids of the iOS/Android apps whose ID tokens POST /auth/google/token accepts
GOOGLE_MOBILE_CLIENT_IDS=

# Cap (milliseconds) on one GET /search statement; past it the endpoint answers 503 search_timeout with Retry-After.
SEARCH_TIMEOUT_MS=2000

# Server-side cache (seconds) for the founder dashboard reads; 0 bypasses it. A product name edit can show up to this late.
DASHBOARD_CACHE_SECONDS=30
