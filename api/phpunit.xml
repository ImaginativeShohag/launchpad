<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="HASH_DRIVER" value="bcrypt"/>
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="PRODUCT_DISK" value="public" force="true"/>
        <env name="AVATAR_DISK" value="public" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="REVERB_APP_ID" value="test-app"/>
        <env name="REVERB_APP_KEY" value="test-key"/>
        <env name="REVERB_APP_SECRET" value="test-secret"/>
        <env name="REVERB_HOST" value="localhost"/>
        <env name="REVERB_PORT" value="8080"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="pgsql"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <env name="DB_USERNAME" value="sail"/>
        <env name="DB_PASSWORD" value="password"/>
        <env name="DB_URL" value=""/>
        <env name="REDIS_VIEWS_DB" value="15" force="true"/>
        <env name="DASHBOARD_CACHE_SECONDS" value="0" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_DOMAIN" value=""/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <env name="WEB_URL" value="http://localhost:5173"/>
        <env name="LAUNCHPAD_HMAC_KEY" value="testing-hmac-key-testing-hmac-key"/>
        <env name="LOG_CHANNEL" value="single"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
